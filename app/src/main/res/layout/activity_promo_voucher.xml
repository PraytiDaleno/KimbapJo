<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#2E7D32">

        <TextView
            android:id="@+id/iv_menu"
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:text="☰"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:gravity="center_vertical" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/iv_profile"
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:text="●"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:gravity="center" />
    </LinearLayout>

    <!-- CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="39dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Promo &amp; Voucher"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="10dp" />

        <!-- CARD 1 -->
        <LinearLayout
            android:id="@+id/btn_promo1"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="18dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_promo_card"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kimbap sayur"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disc 20%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp" />

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="21dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_button_promo"
                    android:gravity="center"
                    android:text="Pesan"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="84dp"
                android:layout_height="65dp"
                android:src="@drawable/kimbab_sayur"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_promo_image" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_promo2"
            android:layout_width="match_parent"
            android:layout_height="102dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="18dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_promo_card"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gratis Ongkir"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min belanja Rp 75.000"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="21dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_button_promo"
                    android:gravity="center"
                    android:text="Pakai"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="84dp"
                android:layout_height="65dp"
                android:src="@drawable/kimbab_sayur"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_promo_image" />

        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#2E7D32">

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="▦"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/nav_favorite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="♥"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/nav_cart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🛒"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>