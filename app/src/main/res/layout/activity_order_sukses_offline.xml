<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <View
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#2E7D32" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="95dp"
                android:layout_height="95dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="55sp"
                android:textStyle="bold"
                android:background="@drawable/bg_circle_success" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesanan Offline Berhasil"
                android:textColor="#1B5E20"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/tv_payment_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pembayaran diterima"
                android:textColor="#333333"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_order_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_table_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TABLE #1"
                        android:textColor="#2E7D32"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/iv_table_icon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_table_white"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_order_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kode Pesanan: KBP001"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/tv_total_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Dibayar: Rp 0"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_payment_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Metode: QRIS"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waktu: -"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estimasi Selesai: 20 menit"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_receipt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Lihat Kuitansi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
