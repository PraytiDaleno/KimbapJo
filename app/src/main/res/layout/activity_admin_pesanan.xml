<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2E7D32">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Daftar Pesanan"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:background="#8086AC" />

    <View
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="#2E7D32" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/filterSemua"
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:text="Semua"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:background="@drawable/bg_button_green" />

                <TextView
                    android:id="@+id/filterBaru"
                    android:layout_width="58dp"
                    android:layout_height="24dp"
                    android:text="Baru"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"
                    android:gravity="center"
                    android:layout_marginStart="36dp"
                    android:background="@drawable/bg_badge_green" />

                <TextView
                    android:id="@+id/filterDiproses"
                    android:layout_width="70dp"
                    android:layout_height="24dp"
                    android:text="Diproses"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"
                    android:gravity="center"
                    android:layout_marginStart="36dp"
                    android:background="@drawable/bg_badge_green" />

                <TextView
                    android:id="@+id/filterSelesai"
                    android:layout_width="65dp"
                    android:layout_height="24dp"
                    android:text="Selesai"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"
                    android:gravity="center"
                    android:layout_marginStart="30dp"
                    android:background="@drawable/bg_badge_green" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerPesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Pesanan 1 -->
            <LinearLayout
                android:id="@+id/cardPesanan1"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:visibility="gone"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_order_card">

                <TextView
                    android:text="Baru"
                    android:textColor="#2E7D32"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_badge_green"
                    android:layout_width="50dp"
                    android:layout_height="20dp" />

                <TextView
                    android:text="#KBP003"
                    android:textColor="#2E7D32"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Prayti N"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="2 x Kimbap Tuna . 1 X Es Serut\n13.42"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnDetail1"
                    android:layout_width="135dp"
                    android:layout_height="34dp"
                    android:text="Lihat Detail      ›"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_button_green" />
            </LinearLayout>

            <!-- Pesanan 2 -->
            <LinearLayout
                android:id="@+id/cardPesanan2"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:visibility="gone"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_order_card">

                <TextView
                    android:text="Diproses"
                    android:textColor="#F57C00"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_badge_orange"
                    android:layout_width="60dp"
                    android:layout_height="20dp" />

                <TextView
                    android:text="#KBP004"
                    android:textColor="#2E7D32"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Jevelin S"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="1 x Nasi Ayam Katsu\n13.30"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnDetail2"
                    android:layout_width="135dp"
                    android:layout_height="34dp"
                    android:text="Lihat Detail      ›"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#2E7D32"
                    android:background="@drawable/bg_button_outline" />
            </LinearLayout>

            <!-- Pesanan 3 -->
            <LinearLayout
                android:id="@+id/cardPesanan3"
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:visibility="gone"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_order_card">

                <TextView
                    android:text="Selesai"
                    android:textColor="#2E7D32"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_badge_green"
                    android:layout_width="55dp"
                    android:layout_height="20dp" />

                <TextView
                    android:text="#KBP005"
                    android:textColor="#2E7D32"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Christo W"
                    android:textColor="#111111"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="1 x Kimbap Sayur . 1 x Nasi Telur Dadar\n13.00"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Button
                    android:id="@+id/btnDetail3"
                    android:layout_width="135dp"
                    android:layout_height="34dp"
                    android:text="Lihat Detail      ›"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#2E7D32"
                    android:background="@drawable/bg_button_outline" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:background="#2E7D32"
        android:gravity="center">

        <ImageView
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            android:src="@drawable/ic_admin_dashboard"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/navPesanan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="18dp"
            android:layout_marginVertical="8dp"
            android:padding="8dp"
            android:background="@drawable/bg_admin_nav_active"
            android:src="@drawable/ic_admin_orders"
            android:tint="#FFC107" />

        <ImageView
            android:id="@+id/navStok"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            android:src="@drawable/ic_admin_stock"
            android:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/navSetting"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="14dp"
            android:src="@drawable/ic_admin_detail"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
